{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_url}/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.pockyl.diegesis.fabric.DiegesisFabric"],
    "client": ["com.pockyl.diegesis.fabric.DiegesisFabricClient"]
  },
  "mixins": ["diegesis.mixins.json", "diegesis.fabric.mixins.json"],
  "accessWidener": "diegesis.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
